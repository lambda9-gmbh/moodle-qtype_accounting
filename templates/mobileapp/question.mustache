{{!
    @template qtype_accounting/mobileapp/question

    Moodle App form. Data is extracted from the quiz question HTML by the app controller.

    Context variables required for this template: none.

    Example context (json): {}
}}
{{=<% %>=}}
<section *ngIf="question && question.accountingSides" class="qtype_accounting-app">
    <core-format-text [text]="question.text" [component]="component" [componentId]="componentId"
        [contextLevel]="contextLevel" [contextInstanceId]="contextInstanceId" [courseId]="courseId">
    </core-format-text>
    <ion-note *ngIf="question.accountingNotice">
        <core-format-text [text]="question.accountingNotice"></core-format-text>
    </ion-note>
    <section *ngFor="let side of question.accountingSides">
        <h3>{{ side.title | translate }}</h3>
        <div *ngFor="let entry of side.entries">
            <ion-card *ngIf="entry.visible">
                <ion-card-content>
                    <ng-container *ngIf="!question.readonly">
                        <ion-item>
                            <ion-select *ngIf="question.accountingAccounts.length" interface="alert" labelPlacement="stacked"
                                [label]="'plugin.qtype_accounting.account' | translate" [value]="entry.account"
                                (ionChange)="entry.account = $event.detail.value">
                                <ion-select-option *ngFor="let account of question.accountingAccounts" [value]="account.value">
                                    {{ account.label }}
                                </ion-select-option>
                            </ion-select>
                            <ion-input *ngIf="!question.accountingAccounts.length" type="text" labelPlacement="stacked"
                                [label]="'plugin.qtype_accounting.account' | translate" [value]="entry.account"
                                (ionInput)="entry.account = $event.detail.value || ''">
                            </ion-input>
                        </ion-item>
                        <ion-item>
                            <ion-input type="text" inputmode="decimal" labelPlacement="stacked"
                                [label]="'plugin.qtype_accounting.amount' | translate" [value]="entry.amount"
                                (ionInput)="entry.amount = $event.detail.value || ''" [placeholder]="question.accountingPlaceholder">
                            </ion-input>
                        </ion-item>
                        <ion-button *ngIf="canRemoveEntry(side)" type="button" fill="clear" color="danger"
                            (click)="removeEntry(side, entry)">
                            {{ 'plugin.qtype_accounting.deleteentry' | translate }}
                        </ion-button>
                    </ng-container>
                    <ng-container *ngIf="question.readonly">
                        <p>{{ 'plugin.qtype_accounting.account' | translate }}</p>
                        <core-format-text [text]="entry.accountReview"></core-format-text>
                        <p>{{ 'plugin.qtype_accounting.amount' | translate }}</p>
                        <core-format-text [text]="entry.amountReview"></core-format-text>
                    </ng-container>
                </ion-card-content>
            </ion-card>
            <%!
                The quiz serializes native form.elements, not Angular's model.
                Always keep one named native input per answer, including deleted rows.
            %>
            <input type="hidden" [attr.name]="entry.accountName" [value]="entry.account">
            <input type="hidden" [attr.name]="entry.amountName" [value]="entry.amount">
        </div>
        <ion-button *ngIf="!question.readonly" type="button" fill="outline" (click)="addEntry(side)">
            {{ side.addLabel | translate }}
        </ion-button>
    </section>
</section>
