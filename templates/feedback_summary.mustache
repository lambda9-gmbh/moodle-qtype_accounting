{{!
    @template qtype_accounting/feedback_summary

    Summary of the feedback on the debit and credit side.

    Context variables required for this template:
    * allcorrect - Whether the response is fully correct.
    * partial - Whether a side is partially correct (warning instead of error).
    * message - The messages for both sides.

    Example context (json): {
        "allcorrect": false,
        "partial": true,
        "message": "The debit side is partially incorrect."
    }
}}
<div class="qtype_accounting-feedback-summary mt-3">
    {{#allcorrect}}
    <div class="alert alert-success">{{#pix}}i/valid, core{{/pix}} {{#str}}allcorrect, qtype_accounting{{/str}}</div>
    {{/allcorrect}}
    {{^allcorrect}}
    <div class="alert {{#partial}}alert-warning{{/partial}}{{^partial}}alert-danger{{/partial}}">{{#partial}}{{#pix}}i/warning, core{{/pix}}{{/partial}}{{^partial}}{{#pix}}i/invalid, core{{/pix}}{{/partial}} {{message}}</div>
    {{/allcorrect}}
</div>
