{{!
    @template qtype_accounting/chart_accounts

    The accounts of a chart of accounts template, with in-place renaming and deletion.

    Context variables required for this template:
    * chartid - The chart ID.
    * count - Number of accounts.
    * hasaccounts - Whether the chart has accounts.
    * sorturl - URL that toggles the sorting by name.
    * sortedasc - Whether the list is sorted by name ascending.
    * sorteddesc - Whether the list is sorted by name descending.
    * accounts - Accounts with name (inplace_editable context), deleteurl and confirmmessage.

    Example context (json):
    {
        "chartid": 1,
        "count": 1,
        "hasaccounts": true,
        "sorturl": "#",
        "sortedasc": true,
        "sorteddesc": false,
        "accounts": [
            {
                "name": {"component": "qtype_accounting", "itemtype": "accountname", "itemid": 3, "displayvalue": "1200 Bank",
                    "value": "1200 Bank", "edithint": "Edit account name", "editlabel": "New name for account 1200 Bank",
                    "editable": true, "type": "text", "options": "", "linkeverything": 0},
                "confirmmessage": "Are you sure you want to delete this account? 1200 Bank",
                "deleteurl": "#"
            }
        ]
    }
}}
<div class="qtype_accounting-account-toolbar d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h3 class="mb-0">{{#str}}editaccounts, qtype_accounting{{/str}} ({{count}})</h3>
    <button type="button" class="btn btn-success" data-action="qtype_accounting-add-account" data-chartid="{{chartid}}">
        {{#str}}addaccount, qtype_accounting{{/str}}
    </button>
</div>
{{#hasaccounts}}
<table class="generaltable qtype_accounting-chart-accounts">
    <thead>
        <tr>
            <th scope="col">
                <a href="{{sorturl}}">{{#str}}accountname, qtype_accounting{{/str}}{{#sortedasc}} {{#pix}}t/sort_asc, core, {{#str}}asc{{/str}}{{/pix}}{{/sortedasc}}{{#sorteddesc}} {{#pix}}t/sort_desc, core, {{#str}}desc{{/str}}{{/pix}}{{/sorteddesc}}</a>
            </th>
            <th scope="col">{{#str}}actions{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#accounts}}
        <tr>
            <td>{{#name}}{{>core/inplace_editable}}{{/name}}</td>
            <td>
                <a href="{{deleteurl}}" data-action="qtype_accounting-delete"
                   data-confirmation-title="{{#str}}deleteaccount, qtype_accounting{{/str}}"
                   data-confirmation-message="{{confirmmessage}}">{{#pix}}t/delete, core, {{#str}}delete{{/str}}{{/pix}}</a>
            </td>
        </tr>
        {{/accounts}}
    </tbody>
</table>
{{/hasaccounts}}
{{^hasaccounts}}
<p class="alert alert-info">{{#str}}noaccounts, qtype_accounting{{/str}}</p>
{{/hasaccounts}}
