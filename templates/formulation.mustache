{{!
    @template qtype_accounting/formulation

    Question text and booking table of an accounting question.
    The container's data attributes configure qtype_accounting/question and the Moodle App.

    Context variables required for this template:
    * questiontext - The formatted question text (HTML).
    * allornothing - Whether to show the no-partial-credit notice.
    * containerid, accountsjson, allowedit, numberformat, currencysymbol, nextindex, maxrows, templateid.
    * table - Context of qtype_accounting/entry_table.

    Example context (json): {
        "questiontext": "<p>Book the sale.</p>",
        "allornothing": true,
        "containerid": "qtype_accounting-container-1",
        "accountsjson": "[]",
        "allowedit": 0,
        "numberformat": "de",
        "currencysymbol": "€",
        "nextindex": 1,
        "maxrows": 100,
        "templateid": "qtype_accounting-entry-template-1",
        "table": {"style": "", "rows": []}
    }
}}
<div class="qtext">{{{questiontext}}}</div>
{{#allornothing}}
<div class="alert alert-warning mt-2 mb-2">{{#str}}allornothinggrading_notice, qtype_accounting{{/str}}</div>
{{/allornothing}}
<div class="qtype_accounting-question-container" id="{{containerid}}" data-accounts="{{accountsjson}}" data-allowedit="{{allowedit}}" data-numberformat="{{numberformat}}" data-currencysymbol="{{currencysymbol}}" data-nextindex="{{nextindex}}" data-maxrows="{{maxrows}}" data-templateid="{{templateid}}">
    {{#table}}{{> qtype_accounting/entry_table}}{{/table}}
    <div class="qtype_accounting-mobile-view"></div>
</div>
