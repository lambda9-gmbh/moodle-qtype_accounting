{{!
    @template qtype_accounting/account_field

    Account select of an entry, or the selected account in review.

    Context variables required for this template:
    * name, value - Field name and selected account ID.
    * readonly - Whether the account is shown for review.
    * display, feedbackclass, correct, incorrect - Review text and correctness.
    * options - Select options (value, label, selected).
    * textinput - Whether a text input is shown instead, if the question has no chart.

    Example context (json): {
        "name": "q1:1_debitaccount_0",
        "value": "1",
        "readonly": false,
        "options": [{"value": "1", "label": "Bank", "selected": true}]
    }
}}
{{#readonly}}
<span class="qtype_accounting-readonly{{#feedbackclass}} {{feedbackclass}}{{/feedbackclass}}">{{display}}</span>{{> qtype_accounting/correctness}}<input type="hidden" name="{{name}}" value="{{value}}">
{{/readonly}}
{{^readonly}}
{{^textinput}}
<select name="{{name}}" id="{{name}}" class="form-control qtype_accounting-account-select" aria-label="{{#cleanstr}}account, qtype_accounting{{/cleanstr}}">
    <option value="">{{#str}}selectaccount, qtype_accounting{{/str}}</option>
    {{#options}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>{{/options}}
</select>
{{/textinput}}
{{#textinput}}
<input type="text" name="{{name}}" id="{{name}}" value="{{value}}" class="form-control qtype_accounting-account-input" placeholder="{{#cleanstr}}enteraccount, qtype_accounting{{/cleanstr}}" aria-label="{{#cleanstr}}account, qtype_accounting{{/cleanstr}}">
{{/textinput}}
{{/readonly}}
