{{!
    @template qtype_accounting/correctness

    Text for screen readers stating whether a reviewed field is correct; the colour alone is not enough.

    Context variables required for this template:
    * correct, incorrect - Whether the field is marked correct or incorrect.

    Example context (json): {"correct": true}
}}
{{#correct}}<span class="accesshide">{{#str}}correct, question{{/str}}</span>{{/correct}}{{#incorrect}}<span class="accesshide">{{#str}}incorrect, question{{/str}}</span>{{/incorrect}}
